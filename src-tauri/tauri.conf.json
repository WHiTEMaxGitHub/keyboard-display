{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "keyboard-display",
  "version": "0.1.0",
  "identifier": "com.whitemax.keyword-display",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "config",
        "title": "Keyboard Display",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640,
        "decorations": false,
        "transparent": true,
        "backgroundColor": [0, 0, 0, 0]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
